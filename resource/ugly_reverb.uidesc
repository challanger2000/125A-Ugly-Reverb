<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <colors>
    <color name="Panel" rgba="#242321ff"/>
    <color name="Panel2" rgba="#1b1a18ff"/>
    <color name="Text" rgba="#d8d0b8ff"/>
    <color name="Muted" rgba="#8f897cff"/>
    <color name="Display" rgba="#10110eff"/>
    <color name="DisplayText" rgba="#c9a75aff"/>
    <color name="Edge" rgba="#555148ff"/>
