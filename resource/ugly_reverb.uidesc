    <bitmap name="ToggleOn" path="embedded_toggle_on_60.png"><data encoding="base64"></data></bitmap>
  </bitmaps>
  <template background-color="Panel" class="CViewContainer" maxSize="760, 430" minSize="760, 430" mouse-enabled="true" name="view" opacity="1" origin="0, 0" size="760, 430" transparent="false">
